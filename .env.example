# ---------------------------------------------------------------------------
# Sistem Manajemen Persuratan Universitas Gajayana (unigamalang)
#
# Copy to `.env.local` for dev, or set each var in the Vercel project settings.
# Only AUTH_SECRET + DATABASE_URL + DIRECT_URL are REQUIRED. Everything else
# gracefully degrades when left blank.
# ---------------------------------------------------------------------------

# REQUIRED — session signing key (>=32 chars)
AUTH_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# REQUIRED — Neon Postgres (or any Postgres). Pooled URL for serverless runtime,
# direct URL for `prisma migrate`.
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require

# STRONGLY RECOMMENDED for production — server timezone. Vercel functions run
# in UTC by default; without this, letter numbers generated between
# 00:00–07:00 WIB can render the wrong month/year token ([ROMAN_MONTH],
# [YEAR]) because the numbering counter resets on the server's local
# midnight, not Jakarta's. Set this in Vercel Project Settings too (not just
# here) — Vercel does not read this file.
TZ=Asia/Jakarta

# Optional — base URL used in email links & webhook self-reference.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Google Drive (preferred storage for letter attachments).
# Service account JSON (the full contents of the .json key file you download
# from IAM → Service Accounts → Keys → Create new key → JSON). The Drive
# folder referenced by GOOGLE_DRIVE_PARENT_FOLDER_ID must be shared to the
# service account's `client_email` with Editor access.
# When either var is missing, uploads fall back to Vercel Blob, then inline.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Optional — Vercel Blob (legacy fallback when Google Drive is not configured).
# When all storage backends are missing, uploads fall back to inline base64 (max 2MB).
BLOB_READ_WRITE_TOKEN=

# Optional — Resend (email notifications for incoming letters & dispositions).
# When missing, email events are logged to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional — Outbound webhook target (e.g. n8n) for letter/disposition events.
# When N8N_WEBHOOK_URL is empty, delivery rows are still recorded but HTTP
# POST is skipped.
N8N_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=change-this-to-another-long-random-string

# STRONGLY RECOMMENDED for production — Disable self-registration. When
# "true", only Super Admin can create accounts (POST /api/users). Leaving
# this unset/false means anyone with an @unigamalang.ac.id email can create
# their own account via /register.
REGISTRATION_DISABLED=true

# STRONGLY RECOMMENDED for production — Cron job authentication (Bearer
# token). /api/cron/mark-overdue and /api/cron/cleanup-audit both fail
# CLOSED (return 401) when this is unset, which means those crons silently
# never run rather than running unauthenticated — but that also means
# "overdue" status and audit-log retention just won't work until this is
# set. Vercel Cron sends this automatically as `Authorization: Bearer
# ${CRON_SECRET}` once the var exists (no extra config needed on the cron
# side — see vercel.json).
CRON_SECRET=

# NOT READY FOR PRODUCTION — UNIGA SSO Gateway integration. Leave every var
# below UNSET for this launch; the "Masuk dengan SSO" button on /login only
# appears when SSO_BASE_URL + SSO_CLIENT_ID + SSO_REDIRECT_URI are all set,
# so leaving them blank keeps SSO fully inactive without touching code.
# The callback (src/app/auth/callback/route.ts) has not yet been reviewed
# for CSRF (state param) or SSO-role/domain validation — see README.
# SSO_BASE_URL=https://sso.unigamalang.ac.id
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://your-deployment.example.com/auth/callback
