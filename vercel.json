{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma migrate deploy && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/mark-overdue",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cleanup-audit",
      "schedule": "0 3 * * 0"
    }
  ]
}
