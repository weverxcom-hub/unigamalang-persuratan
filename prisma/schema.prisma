// Sistem Manajemen Persuratan Universitas Gajayana (unigamalang)
//
// Prisma schema. Target: Postgres (Neon / Supabase free tier).
//
//   DATABASE_URL – pooled connection (runtime, via pgbouncer)
//   DIRECT_URL   – direct connection (prisma migrate)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------------------
//  Enums
// -------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN_UNIT
  USER
}

enum Direction {
  OUTGOING
  INCOMING
}

enum ArchiveStatus {
  DRAFT
  PENDING // USER draft waiting for admin approval
  PENDING_PROOF // Number allocated, awaiting proof upload
  APPROVED
  ISSUED
  // OVERDUE: PENDING_PROOF that exceeded the 14-day proof deadline. The cron
  // at /api/cron/mark-overdue flips PENDING_PROOF → OVERDUE; an admin can
  // still upload proof afterwards (status returns to ISSUED) — `overdueMarkedAt`
  // remains as a permanent record of lateness.
  OVERDUE
  // VOID: an allocated number that was cancelled before issuance. Reason is
  // mandatory. The number is NOT released back to the counter; it stays in
  // the archive list with a red badge so audit trail is preserved.
  VOID
}

enum DispositionStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  UPLOAD
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  DISPOSITION_CREATE
  DISPOSITION_UPDATE
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Help-desk ticket lifecycle. Created by any authenticated user via the
/// in-app "Laporkan Masalah" form; managed by SUPER_ADMIN.
enum TicketStatus {
  NEW          // baru masuk, belum disentuh
  IN_PROGRESS  // sedang ditangani superadmin
  RESOLVED     // sudah selesai dengan respons
  CLOSED       // ditutup tanpa tindakan / duplikat
}

enum LetterTypeScope {
  // GLOBAL: dropdown muncul di semua unit. Default untuk semua jenis surat
  // standar (SK, ST, INT, MOU, EKS) yang sudah ada sebelum PR-D.
  GLOBAL
  // UNIT_SPECIFIC: jenis hanya muncul di unit-unit yang ter-allowlist via
  // tabel join LetterTypeUnit. Disetujui oleh SUPER_ADMIN dari LetterTypeRequest.
  UNIT_SPECIFIC
}

enum LetterTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------------------------------------------------------------
//  Core entities
// -------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  unitId       String?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Soft-delete sentinel. When non-null, account is deactivated: cannot
  // log in and is hidden from list endpoints by default.
  deletedAt    DateTime?

  // Self-service password reset. Token is a random hex string; expires
  // after 1 hour. Both fields are cleared after a successful reset.
  resetToken          String?
  resetTokenExpiresAt DateTime?

  archives             Archive[]
  archivesVoided       Archive[]     @relation("ArchiveVoidedBy")
  dispositionsSent     Disposition[] @relation("DispositionFrom")
  dispositionsReceived Disposition[] @relation("DispositionTo")
  auditLogs            AuditLog[]
  ticketsCreated       Ticket[]      @relation("TicketCreator")
  ticketsAssigned      Ticket[]      @relation("TicketAssignee")
  letterTypeRequestsRequested LetterTypeRequest[] @relation("LetterTypeRequestRequestedBy")
  letterTypeRequestsReviewed  LetterTypeRequest[] @relation("LetterTypeRequestReviewedBy")

  @@index([unitId])
  @@index([deletedAt])
}

model Unit {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "UNIGA", "YAS"
  name           String
  // Template for numbering. Supported placeholders:
  //   [NO]          zero-padded sequence (3 digits)
  //   [UNIT_CODE]   this unit's code
  //   [TYPE_CODE]   selected letter type code
  //   [ROMAN_MONTH] current month in Roman numerals (I..XII)
  //   [MONTH]       current month (1..12)
  //   [YEAR]        current 4-digit year
  formatTemplate String    @default("[NO]/[TYPE_CODE]/[UNIT_CODE]/[ROMAN_MONTH]/[YEAR]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Soft delete — never hard-delete (Archive.unit / User.unit / sequences
  // reference this row).
  deletedAt      DateTime?

  users        User[]
  archives     Archive[]
  sequences    NumberingSequence[]
  dispositions Disposition[]
  tickets      Ticket[]
  letterTypes  LetterTypeUnit[]
  letterTypeRequestsSent     LetterTypeRequest[] @relation("LetterTypeRequestUnit")

  @@index([deletedAt])
}

model LetterType {
  id        String          @id @default(cuid())
  code      String          @unique // e.g. "SK", "ST"
  name      String
  // GLOBAL = dropdown di semua unit. UNIT_SPECIFIC = hanya unit yang
  // tercantum di LetterTypeUnit. Default GLOBAL untuk backward-compat.
  scope     LetterTypeScope @default(GLOBAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  // Soft delete — never hard-delete (Archive.letterType references this
  // row).
  deletedAt DateTime?

  archives  Archive[]
  sequences NumberingSequence[]
  units     LetterTypeUnit[]

  @@index([deletedAt])
}

/// Join table: which units are allowed to use a UNIT_SPECIFIC letter type.
/// Ignored for GLOBAL letter types (they're available to every unit).
model LetterTypeUnit {
  letterTypeId String
  letterType   LetterType @relation(fields: [letterTypeId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([letterTypeId, unitId])
  @@index([unitId])
}

/// Request from an ADMIN_UNIT for a new UNIT_SPECIFIC letter type. Goes into
/// a queue that SUPER_ADMIN approves or rejects from the letter-types page.
/// On approval the SUPER_ADMIN picks which units the new type is available to.
model LetterTypeRequest {
  id            String                  @id @default(cuid())
  // Proposed code & name. After approval the SUPER_ADMIN may tweak these
  // before creating the LetterType, but we store what the requester asked
  // for as audit trail.
  proposedCode  String
  proposedName  String
  // Free-form rationale ("Untuk surat tugas spesifik fakultas teknik").
  reason        String
  status        LetterTypeRequestStatus @default(PENDING)
  // Who asked for it. unitId is required because UNIT_SPECIFIC types are
  // always scoped to one or more units; the requester's home unit is the
  // default allowlist when a SUPER_ADMIN approves.
  requestedById String
  requestedBy   User                    @relation("LetterTypeRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit                    @relation("LetterTypeRequestUnit", fields: [unitId], references: [id], onDelete: Cascade)
  // Filled when SUPER_ADMIN approves/rejects.
  reviewedById  String?
  reviewedBy    User?                   @relation("LetterTypeRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  // If approved, the LetterType row that was created (so we can link the
  // request → the actual letter type for audit).
  letterTypeId  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([unitId])
}

/// Per-(unit, letterType, year) sequence counter. Each combination of unit
/// and letter type gets its own running counter that resets every January.
/// Reflects how UNIGA's birokrasi actually numbers letters: SK has its own
/// stream, ST has its own, etc.
model NumberingSequence {
  id           String     @id @default(cuid())
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  letterTypeId String
  letterType   LetterType @relation(fields: [letterTypeId], references: [id], onDelete: Cascade)
  year         Int
  last         Int        @default(0)
  updatedAt    DateTime   @updatedAt

  @@unique([unitId, letterTypeId, year])
  @@index([unitId, year])
  @@index([letterTypeId, year])
}

model Archive {
  id             String        @id @default(cuid())
  number         String // e.g. "001/UNIGA/SK/IV/2026"
  date           DateTime      @default(now())
  subject        String
  recipient      String // internal recipient / tujuan (OUTGOING) or internal receiver (INCOMING)
  externalSender String? // free-text sender for INCOMING letters
  direction      Direction     @default(OUTGOING)
  status         ArchiveStatus @default(PENDING_PROOF)

  unitId         String
  unit           Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unitCode       String // denormalised for fast display
  letterTypeId   String
  letterType     LetterType @relation(fields: [letterTypeId], references: [id], onDelete: Restrict)
  letterTypeCode String

  sequenceNumber Int @default(0)

  fileUrl      String? // Storage URL (Google Drive webViewLink, or legacy Vercel Blob URL)
  blobPathname String? // Vercel Blob pathname (legacy, for cleanup of old Blob assets)
  gdriveFileId String? // Google Drive file ID, for permission management & deletion
  fileName     String?
  fileDataUrl  String? // legacy inline base64; superseded by fileUrl

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete — never hard-delete. Queries should filter deletedAt: null.
  deletedAt   DateTime?

  // VOID metadata. Filled by POST /api/archives/[id]/void; immutable after.
  voidReason  String?
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?     @relation("ArchiveVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  // OVERDUE marker. Set by the cron once `now() - createdAt > 14 days` and
  // status is still PENDING_PROOF. Preserved even after a late proof upload.
  overdueMarkedAt DateTime?

  // Sisipan / manual-override metadata. Set by POST /api/archives when the
  // admin supplies a manual number (instead of letting the system generate
  // the next sequence). isInsert flags the row so it's visible to auditors,
  // and insertReason captures the justification (e.g. "surat backdate
  // karena keterlambatan administratif"). Required when isInsert = true.
  isInsert     Boolean @default(false)
  insertReason String?

  dispositions Disposition[]
  auditLogs    AuditLog[]

  @@index([unitId])
  @@index([letterTypeId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([direction])
  @@index([status])
  @@index([date])
  @@index([number])
}

model Disposition {
  id           String            @id @default(cuid())
  archiveId    String
  archive      Archive           @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User              @relation("DispositionFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId     String?
  toUser       User?             @relation("DispositionTo", fields: [toUserId], references: [id], onDelete: SetNull)
  toUnitId     String?
  toUnit       Unit?             @relation(fields: [toUnitId], references: [id], onDelete: SetNull)
  instructions String
  dueDate      DateTime?
  status       DispositionStatus @default(PENDING)
  note         String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acknowledgedAt DateTime?
  completedAt    DateTime?

  @@index([archiveId])
  @@index([toUserId])
  @@index([toUnitId])
  @@index([status])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // denormalised for post-deletion traceability
  targetType String // "Archive" | "Disposition" | "User" | "Unit" | "LetterType" | "Auth"
  targetId   String?
  archiveId  String?
  archive    Archive?    @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  metadata   Json? // free-form diff / payload
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([archiveId])
  @@index([createdAt])
}

/// Outbound webhook delivery log. Every letter-create event enqueues a row
/// here; the app delivers to `N8N_WEBHOOK_URL` and records success/failure.
model WebhookDelivery {
  id             String                @id @default(cuid())
  event          String // e.g. "archive.created", "disposition.created"
  archiveId      String?
  targetUrl      String
  payload        Json
  signature      String // HMAC-SHA256 of payload with WEBHOOK_SIGNING_SECRET
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastError      String?
  responseStatus Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@index([archiveId])
  @@index([createdAt])
}

/// Help-desk ticket / error report submitted from the in-app
/// "Laporkan Masalah" button. Visible to the reporter via /dashboard/my-tickets
/// and to SUPER_ADMIN via /dashboard/tickets.
model Ticket {
  id                 String       @id @default(cuid())
  title              String
  description        String       @db.Text
  // Optional free-text label for the page/feature being reported (e.g.
  // "/dashboard/generate" or "Form Buat Nomor Surat"). Lets the reporter
  // give superadmin a hint about where the issue is, without forcing them
  // to remember exact paths.
  pageHint           String?
  // Optional screenshot. Reuses the same Vercel Blob upload flow as archive
  // proofs (path prefix `persuratan/{userId}/tickets/...`). Stored as both
  // a public URL (for inline preview) and a pathname (for delete on cleanup).
  screenshotUrl      String?
  screenshotPathname String?

  status       TicketStatus @default(NEW)
  // Optional follow-up note from the superadmin reviewing the ticket.
  // Visible to the reporter on /dashboard/my-tickets.
  responseNote String?      @db.Text

  createdById String
  createdBy   User    @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  // Denormalised reporter unit so superadmin can filter / aggregate without
  // joining through User. Nullable because USER role accounts may not have a
  // unit.
  unitId      String?
  unit        Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Optional explicit owner among superadmins; for now it's free-form so
  // multiple superadmins can collaborate.
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([unitId])
  @@index([createdAt])
}
